@inject NavigationManager Urihelper

@* SEO Variables - Single source of truth for all meta tags *@
@{
    string SeoTitle = "Stockmarket Dashboard - Syncfusion Blazor Showcase";
    string SeoDescription = "Real-time stock market data visualization and analysis dashboard application.";
    string SiteUrl = Urihelper.Uri.TrimEnd('/');
    string ApplicationName = "Stockmarket Dashboard";
    string Publisher = "Syncfusion";
    string Language = "English";
    string SocialImage = SiteUrl + "/StockmarketDashboard.svg";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    
    <!-- HTML Title -->
    <title>@SeoTitle</title>
    
    <!-- Primary Meta Tags -->
    <meta name="title" content="@SeoTitle" />
    <meta name="description" content="@SeoDescription" />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="Stock Market Dashboard, financial data, stock analysis, real-time data, Blazor components, chart visualization, Syncfusion" />
    <meta name="publisher" content="@Publisher" />
    <meta name="language" content="@Language" />
    
    <!-- Canonical URL -->
    <link href="https://showcase.syncfusion.com/stock-market/blazor/" rel="canonical" />
    
    <!-- Alternate Language Tags -->
    <link rel="alternate" hreflang="en-US" href="@SiteUrl" />
    <link rel="alternate" hreflang="x-default" href="@SiteUrl" />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@SeoTitle" />
    <meta property="og:description" content="@SeoDescription" />
    <meta property="og:url" content="@SiteUrl" />
    <meta property="og:site_name" content="@ApplicationName" />
    <meta property="og:image" content="@SocialImage" />
    <meta property="og:image:alt" content="@ApplicationName Logo" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@SeoTitle" />
    <meta name="twitter:description" content="@SeoDescription" />
    <meta name="twitter:image" content="@SocialImage" />
    <meta name="twitter:image:alt" content="@ApplicationName" />
    <meta name="twitter:site" content="@@Syncfusion" />
    
    <base href="/" />
    <!-- Google Tag Manager -->
    <!-- Load GTM-WXZ6DX9B immediately on page load  -->
    <script>
        (function (w, d, s, l, i) {
            w[l] = w[l] || []; w[l].push({
                'gtm.start':
                    new Date().getTime(), event: 'gtm.js'
            }); var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                    'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-WXZ6DX9B');
    </script>
    <!-- Load GTM-W8WD8WN on user interaction -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const events = ["mousemove", "scroll", "keydown", "touchstart"];
            function loadGTM() {
                events.forEach(event => document.removeEventListener(event, loadGTM));
                (function (w, d, s, l, i) {
                    w[l] = w[l] || []; w[l].push({
                        'gtm.start':
                            new Date().getTime(), event: 'gtm.js'
                    }); var f = d.getElementsByTagName(s)[0],
                        j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                            'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
                })(window, document, 'script', 'dataLayer', 'GTM-W8WD8WN');
            }
            events.forEach(event => document.addEventListener(event, loadGTM, { once: true }));
        });
    </script>

    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/bootstrap/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["StockMarket.styles.css"]" />
    <ImportMap />
    <link rel="shortcut icon" href="favicon.ico" />
    <link href="@Assets["css/site.css"]" rel="stylesheet" />
    <link href="@Assets["styles/BasicLayout.css"]" rel="stylesheet" />
    <link href="@Assets["css/ChartModule.css"]" rel="stylesheet" />
    <link href="@Assets["css/KeyStatsModule.css"]" rel="stylesheet" />
    <link href="@Assets["css/PerfomanceModule.css"]" rel="stylesheet" />
    <link href="@Assets["css/TechnicalModule.css"]" rel="stylesheet" />
    <link href="@Assets["css/WatchListModule.css"]" rel="stylesheet" />
    <script src="@Assets["./scripts/mobile-mode.js"]"></script>
    <link href="@Assets["_content/Syncfusion.Blazor.Themes/fluent2.css"]" rel="stylesheet" />
    
    <!-- Schema.org Structured Data - SoftwareApplication -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org/",
      "@@type": "SoftwareApplication",
      "name": "@ApplicationName",
      "description": "@SeoDescription",
      "url": "@SiteUrl",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "browserRequirements": "Modern browser",
      "image": "@SocialImage",
      "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "author": {
        "@@type": "Organization",
        "name": "@Publisher",
        "url": "https://www.syncfusion.com"
      },
      "inLanguage": "en-US"
    }
    </script>
    
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <!-- Google Tag Manager (noscript) -->
    <!--Page Load-->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WXZ6DX9B" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!--Interaction-->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W8WD8WN" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
    <ReconnectModal />
    <script src="@Assets["_content/Syncfusion.Blazor.Core/scripts/syncfusion-blazor.min.js"]" type="text/javascript"></script>
    <script src="@Assets["_framework/blazor.server.js"]"></script>
</body>

</html>
